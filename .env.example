# Threads API long-lived user access token.
# Get this from Meta for Developers > your app > Threads API > Generate Access Token,
# after your app has the threads_basic and threads_keyword_search permissions
# (add threads_content_publish too if you plan to use Phase 5 posting).
# Never commit your real .env file.
THREADS_ACCESS_TOKEN=

# Usually no need to change these.
THREADS_API_BASE_URL=https://graph.threads.net/v1.0
THREADS_API_TIMEOUT_SECONDS=10
THREADS_API_MAX_RETRIES=3
THREADS_API_BACKOFF_BASE_SECONDS=1
THREADS_API_SEARCH_LIMIT=25

# --- AI analysis (Phase 2) ---
# "anthropic" or "openai" — selects which client app/services/ai/factory.py builds.
AI_PROVIDER=anthropic

# Only the key for the provider you selected above is required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_BACKOFF_BASE_SECONDS=1
# Retries when the model's JSON response fails schema validation (re-asks, no backoff).
AI_MAX_PARSE_RETRIES=2

# --- Original post generation (Phase 3) ---
# Only analyzed posts with viral_score >= this are eligible for generation.
GENERATION_MIN_VIRAL_SCORE=70
# After the first attempt, how many more times to regenerate a rejected draft
# before giving up and marking it manual_review. Total attempts = 1 + this value.
GENERATION_MAX_REGENERATIONS=3

# Similarity backend for comparing a generated draft against its source post
# (and against other recently generated drafts, for duplicate detection):
#   auto            - use OpenAI embeddings if OPENAI_API_KEY is set, else fall back
#                      to a string-similarity ratio (Anthropic has no embeddings API)
#   string          - always use the string-similarity ratio (no API calls)
#   openai_embedding - always use OpenAI embeddings (errors if OPENAI_API_KEY unset)
SIMILARITY_BACKEND=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# A draft is rejected if its similarity to the source post's text is >= this.
SEMANTIC_SIMILARITY_REJECT_THRESHOLD=0.80
# A draft is rejected if its similarity to any recently generated draft is >= this.
DUPLICATE_SIMILARITY_REJECT_THRESHOLD=0.80
DUPLICATE_CHECK_POOL_SIZE=50

# --- Threads publishing (Phase 5) ---
# The numeric Threads user id to publish as (NOT the access token). You can
# get this from the Threads API's own /me endpoint, or from the app dashboard
# where you generated the access token.
THREADS_USER_ID=
# Recommended wait between creating a media container and publishing it
# (documented Meta recommendation). Lowering this may cause publish to fail
# because the container isn't ready yet.
THREADS_PUBLISH_WAIT_SECONDS=30
# false (default): the Streamlit "Threads投稿" page still works (every post
# there requires an explicit click), but scripts/run_publish.py refuses to
# run at all — so nothing can post unattended.
# true: scripts/run_publish.py is allowed to publish every approved and
# not-yet-posted candidate without further confirmation (e.g. from cron).
# Only approved candidates are ever posted either way.
AUTO_POST=false

# SQLite DB file path.
DATABASE_PATH=data/threads_insight.db

LOG_DIR=logs
LOG_LEVEL=INFO
